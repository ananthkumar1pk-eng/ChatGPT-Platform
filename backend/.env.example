# ==============================================================================
# ChatGPT-Platform Backend Configuration
# ==============================================================================

# Application Settings
APP_NAME="ChatGPT-Platform API"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://chatgpt-platform.vercel.app"

# Database Configuration (Defaults to SQLite for local development; use PostgreSQL for production)
# PostgreSQL Example: postgresql+asyncpg://postgres:password@localhost:5432/chatgpt_db
DATABASE_URL="sqlite+aiosqlite:///./chatgpt.db"

# Security & JWT Authentication
SECRET_KEY="supersecret_jwt_signing_key_change_in_production_min_32_chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth 2.0 Credentials (Optional - for Google Login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Hosted LLM Inference API Keys (Add any keys you have; smart fallback active if left empty)
GROQ_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""

# Default Inference Settings
DEFAULT_MODEL="llama-3.3-70b-versatile"
DEFAULT_PROVIDER="groq"
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048
DEFAULT_SYSTEM_PROMPT="You are a helpful, brilliant, and thoughtful AI assistant. Respond concisely and accurately using markdown formatting."

# File Upload Settings
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR="./uploads"
